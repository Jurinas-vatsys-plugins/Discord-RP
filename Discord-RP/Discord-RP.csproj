<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>11</LangVersion>
    <AssemblyName>Discord-RP</AssemblyName>
    <RootNamespace>DiscordRP</RootNamespace>
    <VatSysSourcePath Condition="'$(VatSysSourcePath)' == ''">$(MSBuildThisFileDirectory)..\..\source-code</VatSysSourcePath>
    <VatSysPath Condition="'$(VatSysPath)' == ''">$(MSBuildThisFileDirectory)..\..\vatSys\bin\vatSys.exe</VatSysPath>
    <VatSysDirectory>$([System.IO.Path]::GetDirectoryName('$(VatSysPath)'))</VatSysDirectory>
    <AppIconPath Condition="'$(AppIconPath)' == ''">$(VatSysSourcePath)\vatSys\app.ico</AppIconPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="vatSys"><HintPath>$(VatSysPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="RossCarlson.Vatsim.Network"><HintPath>$(VatSysDirectory)\RossCarlson.Vatsim.Network.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <None Update="presence.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(AppIconPath)" Link="app.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(AppIconPath)')" />
  </ItemGroup>
  <Target Name="CheckVatSysReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VatSysPath)')" Text="vatSys.exe was not found. Build with -p:VatSysPath=&quot;C:\path\to\vatSys\bin\vatSys.exe&quot;." />
  </Target>
</Project>
